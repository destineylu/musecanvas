# 平台后端配置
HOST=127.0.0.1
PORT=8787
# local = 桌面免登录；NAS 每人独立容器使用 account
ACCESS_MODE=local
COOKIE_SECURE=0
MUSECANVAS_UPSTREAM=bridge

# 原版账号池接入。MUSE_KEY 与旧引擎配置里的 MUSE2API_KEY 一致。
MUSE_BASE=http://127.0.0.1:18610
MUSE_KEY=

# 在程序接入方式页管理 Bridge 地址、密钥和模型映射。
# 节点配置保存在 server/data/bridges.json。
BRIDGE_CHAT_MODEL=muse
BRIDGE_IMAGE_MODEL=muse-image
BRIDGE_VIDEO_MODEL=muse-video
BRIDGE_CONCURRENCY=3
BRIDGE_TIMEOUT_MS=7800000
BRIDGE_DOWNLOAD_TIMEOUT_MS=1900000

# 登录签名密钥，启动前请替换为至少 32 个字符的随机值
JWT_SECRET=replace-with-output-from-node-crypto-randomBytes
JWT_DAYS=14

# 对外访问地址（留空自动识别）
PUBLIC_BASE=

# 管理员
ADMIN_EMAIL=admin@muse.local
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# 定价（积分）：视频 = base + 每秒单价 × 时长
PRICE_VIDEO_BASE=10
PRICE_VIDEO_PER_SEC=2
PRICE_IMAGE=5

# 注册赠送积分 / 是否开放注册
SIGNUP_CREDITS=100
ALLOW_REGISTER=1
