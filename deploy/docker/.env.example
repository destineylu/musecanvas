# 复制为 .env 后逐项修改；这些值会被注入 Mua 容器
# 生成随机值：node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"

# ---------- 安全相关（必须改） ----------
# 至少 32 个字符，泄露等于别人能伪造登录态
JWT_SECRET=CHANGE_ME_请替换为至少32位随机字符串
JWT_DAYS=14
ACCESS_MODE=account
# HTTPS 入口用 1；仅内网 HTTP 调试用 0
COOKIE_SECURE=1
# 管理员账号：仅在数据库首次初始化时创建一次，之后改这里无效
ADMIN_EMAIL=admin@mua.local
ADMIN_PASSWORD=CHANGE_ME_请替换为至少12位密码
# 内置 Bridge 管理，登录后添加容器可访问的节点。
MUA_UPSTREAM=bridge
MUSE_BASE=
MUSE_KEY=

# ---------- 访问地址 ----------
# 反代后的对外地址；留空则用相对路径（推荐留空）
PUBLIC_BASE=https://mua.example.com

# ---------- 注册与积分 ----------
# 0 = 关闭注册（多人环境强烈建议 0，由管理员手动开一次再关）
ALLOW_REGISTER=0
# 新用户注册赠送积分
SIGNUP_CREDITS=100
# 定价：图片 5 积分/张；视频 = 10 + 每秒 2 积分
PRICE_IMAGE=5
PRICE_VIDEO_BASE=10
PRICE_VIDEO_PER_SEC=2

# ---------- 上游模型 ----------
BRIDGE_CHAT_MODEL=muse
BRIDGE_IMAGE_MODEL=muse-image
BRIDGE_VIDEO_MODEL=muse-video
BRIDGE_CONCURRENCY=3
